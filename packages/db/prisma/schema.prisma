// Solident shared schema (docs/SPEC.md §5), used by apps/web and, from Phase 4, apps/terminal.
// Conventions: UUID ids; snake_case tables/columns in Postgres (@map/@@map), camelCase in TypeScript;
// translatable columns suffixed Fr/Ar/En (French required, Arabic/English fall back to French).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  admin
  treasurer
  hr
  media
  member
}

enum EventType {
  caravane
  scientifique
  solifun
  ambassadeurs
  autre
}

enum Profile {
  etudiant
  praticien
  public
}

enum RegistrationStatus {
  new
  processed
  cancelled
}

enum DonationStatus {
  pending
  confirmed
  rejected
}

enum DonationSource {
  form
  manual
}

enum PartnerType {
  sponsor
  association
  ecole
  universite
  sport
}

enum VolunteerStatus {
  new
  contacted
  accepted
  declined
}

enum InquiryKind {
  contact
  sponsor
}

enum InquiryStatus {
  new
  in_progress
  closed
}

enum MediaOwnerType {
  programme
  action
  event
  campaign
  partner
}

// ───────────────────────── Auth.js ─────────────────────────
// Field names follow the @auth/prisma-adapter contract; do not rename them.

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?
  role          Role      @default(member)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts           Account[]
  sessions           Session[]
  confirmedDonations Donation[] @relation("DonationConfirmedBy")
  createdEvents      Event[]    @relation("EventCreatedBy")
  auditLogs          AuditLog[]

  @@map("users")
}

model Account {
  userId            String   @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ───────────────────────── Content ─────────────────────────

model Programme {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  titleFr   String   @map("title_fr")
  titleAr   String?  @map("title_ar")
  titleEn   String?  @map("title_en")
  summaryFr String?  @map("summary_fr")
  summaryAr String?  @map("summary_ar")
  summaryEn String?  @map("summary_en")
  bodyFr    String?  @map("body_fr")
  bodyAr    String?  @map("body_ar")
  bodyEn    String?  @map("body_en")
  coverUrl  String?  @map("cover_url")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions Action[]
  events  Event[]

  @@map("programmes")
}

model Action {
  id                 String    @id @default(uuid()) @db.Uuid
  slug               String    @unique
  programmeId        String?   @map("programme_id") @db.Uuid
  titleFr            String    @map("title_fr")
  titleAr            String?   @map("title_ar")
  titleEn            String?   @map("title_en")
  dateStart          DateTime  @map("date_start") @db.Date
  dateEnd            DateTime? @map("date_end") @db.Date
  location           String?
  lat                Float?
  lng                Float?
  beneficiariesCount Int?      @map("beneficiaries_count")
  bodyFr             String?   @map("body_fr")
  bodyAr             String?   @map("body_ar")
  bodyEn             String?   @map("body_en")
  coverUrl           String?   @map("cover_url")
  isPublished        Boolean   @default(false) @map("is_published")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  partners  ActionPartner[]
  campaigns Campaign[]

  @@index([programmeId])
  @@index([dateStart])
  @@map("actions")
}

// Replaces spec's actions.partner_ids[] so every link points at a real partner.
model ActionPartner {
  actionId  String @map("action_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid

  action  Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([actionId, partnerId])
  @@index([partnerId])
  @@map("action_partners")
}

model Event {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  type             EventType
  programmeId      String?   @map("programme_id") @db.Uuid
  titleFr          String    @map("title_fr")
  titleAr          String?   @map("title_ar")
  titleEn          String?   @map("title_en")
  bodyFr           String?   @map("body_fr")
  bodyAr           String?   @map("body_ar")
  bodyEn           String?   @map("body_en")
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(3)
  location         String?
  capacity         Int?
  registrationOpen Boolean   @default(false) @map("registration_open")
  coverUrl         String?   @map("cover_url")
  isPublished      Boolean   @default(false) @map("is_published")
  createdById      String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme     Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([type, startsAt])
  @@index([programmeId])
  @@map("events")
}

model Registration {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  fullName  String             @map("full_name")
  phone     String
  email     String?
  city      String?
  profile   Profile
  note      String?
  status    RegistrationStatus @default(new)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Events with registrations cannot be deleted (default Restrict); unpublish them instead.
  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, phone])
  @@index([eventId, status])
  @@map("registrations")
}

// ───────────────────────── Fundraising ─────────────────────────

model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  titleFr     String    @map("title_fr")
  titleAr     String?   @map("title_ar")
  titleEn     String?   @map("title_en")
  summaryFr   String?   @map("summary_fr")
  summaryAr   String?   @map("summary_ar")
  summaryEn   String?   @map("summary_en")
  goalDh      Int       @map("goal_dh")
  // Cached from confirmed donations; recalculated inside the confirm/reject transaction.
  raisedDh    Int       @default(0) @map("raised_dh")
  donorsCount Int       @default(0) @map("donors_count")
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  coverUrl    String?   @map("cover_url")
  isActive    Boolean   @default(true) @map("is_active")
  actionId    String?   @map("action_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  action    Action?    @relation(fields: [actionId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([actionId])
  @@map("campaigns")
}

model Donation {
  id            String         @id @default(uuid()) @db.Uuid
  campaignId    String         @map("campaign_id") @db.Uuid
  donorName     String?        @map("donor_name")
  email         String?
  phone         String?
  amountDh      Int            @map("amount_dh")
  isAnonymous   Boolean        @default(false) @map("is_anonymous")
  // Object key in the private R2 bucket; served only through short-lived signed URLs.
  proofKey      String?        @map("proof_key")
  status        DonationStatus @default(pending)
  source        DonationSource @default(form)
  adminNote     String?        @map("admin_note")
  confirmedById String?        @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  confirmedBy User?    @relation("DonationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([status, createdAt])
  @@map("donations")
}

model SponsorTier {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  minDh      Int      @map("min_dh")
  // Arrays of benefit strings, e.g. ["Logo sur les réseaux sociaux", ...]
  benefitsFr Json     @map("benefits_fr")
  benefitsAr Json?    @map("benefits_ar")
  benefitsEn Json?    @map("benefits_en")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inquiries Inquiry[]

  @@map("sponsor_tiers")
}

// ───────────────────────── People & organisations ─────────────────────────

model Partner {
  id        String      @id @default(uuid()) @db.Uuid
  slug      String      @unique
  name      String
  logoUrl   String?     @map("logo_url")
  type      PartnerType
  website   String?
  isVisible Boolean     @default(true) @map("is_visible")
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions ActionPartner[]

  @@map("partners")
}

model TeamMember {
  id              String   @id @default(uuid()) @db.Uuid
  fullName        String   @map("full_name")
  roleFr          String   @map("role_fr")
  roleAr          String?  @map("role_ar")
  roleEn          String?  @map("role_en")
  photoUrl        String?  @map("photo_url")
  phone           String?
  isPublicContact Boolean  @default(false) @map("is_public_contact")
  order           Int      @default(0)
  isBoard         Boolean  @default(true) @map("is_board")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("team_members")
}

// ───────────────────────── Public forms ─────────────────────────

model VolunteerApplication {
  id           String          @id @default(uuid()) @db.Uuid
  fullName     String          @map("full_name")
  email        String?
  phone        String
  city         String?
  profile      Profile?
  skills       String?
  availability String?
  motivation   String?
  status       VolunteerStatus @default(new)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("volunteer_applications")
}

model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  kind         InquiryKind
  fullName     String?       @map("full_name")
  organisation String?
  email        String
  phone        String?
  message      String?
  tierId       String?       @map("tier_id") @db.Uuid
  status       InquiryStatus @default(new)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tier SponsorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([kind, status, createdAt])
  @@map("inquiries")
}

// ───────────────────────── Media, stats, audit ─────────────────────────

// Polymorphic gallery item: owner_type + owner_id point at a programme/action/event/... (no FK by design).
model Media {
  id        String         @id @default(uuid()) @db.Uuid
  ownerType MediaOwnerType @map("owner_type")
  ownerId   String         @map("owner_id") @db.Uuid
  r2Key     String         @map("r2_key")
  url       String
  altFr     String?        @map("alt_fr")
  altAr     String?        @map("alt_ar")
  altEn     String?        @map("alt_en")
  width     Int?
  height    Int?
  order     Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerType, ownerId, order])
  @@map("media")
}

// Cached homepage counters, recalculated when the underlying data changes.
model ImpactStat {
  key       String   @id
  value     Int
  labelFr   String   @map("label_fr")
  labelAr   String?  @map("label_ar")
  labelEn   String?  @map("label_en")
  order     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("impact_stats")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
