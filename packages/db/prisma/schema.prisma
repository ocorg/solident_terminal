// Solident shared schema (docs/SPEC.md §5), used by apps/web and, from Phase 4, apps/terminal.
// Conventions: UUID ids; snake_case tables/columns in Postgres (@map/@@map), camelCase in TypeScript;
// translatable columns suffixed Fr/Ar/En (French required, Arabic/English fall back to French).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  admin
  treasurer
  hr
  media
  member
}

enum EventType {
  caravane
  scientifique
  solifun
  ambassadeurs
  autre
}

enum Profile {
  etudiant
  praticien
  public
}

enum RegistrationStatus {
  new
  processed
  cancelled
}

enum DonationStatus {
  pending
  confirmed
  rejected
}

enum DonationSource {
  form
  manual
}

enum PartnerType {
  sponsor
  association
  ecole
  universite
  sport
}

enum VolunteerStatus {
  new
  contacted
  accepted
  declined
}

enum InquiryKind {
  contact
  sponsor
}

enum InquiryStatus {
  new
  in_progress
  closed
}

enum MediaOwnerType {
  programme
  action
  event
  campaign
  partner
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────
// Model and field names follow Better Auth's core schema (user/session/account/verification);
// do not rename the Prisma fields. Better Auth generates UUID ids (advanced.database.generateId).

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  email              String   @unique
  emailVerified      Boolean  @default(false) @map("email_verified")
  image              String?
  role               Role     @default(member)
  isActive           Boolean  @default(true) @map("is_active")
  // Members area (ex-Terminal)
  username           String?  @unique
  emailNotifications Boolean  @default(true) @map("email_notifications")
  // Full rights in the members area (ex-Terminal is_admin), without website /admin access.
  spaceAdmin         Boolean  @default(false) @map("space_admin")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts           Account[]
  sessions           Session[]
  confirmedDonations Donation[] @relation("DonationConfirmedBy")
  createdEvents      Event[]    @relation("EventCreatedBy")
  auditLogs          AuditLog[]

  celluleMemberships CelluleMember[]
  projectMemberships ProjectMember[]
  proposedProjects   Project[]           @relation("ProjectProposedBy")
  proposals          ProjectProposal[]   @relation("ProposalBy")
  suggestedChefFor   ProjectProposal[]   @relation("ProposalChef")
  reviewedProposals  ProjectProposal[]   @relation("ProposalReviewer")
  createdTasks       Task[]              @relation("TaskCreatedBy")
  updatedTasks       Task[]              @relation("TaskUpdatedBy")
  taskAssignments    TaskAssignee[]
  taskComments       TaskComment[]
  createdTeamEvents  TeamEvent[]
  teamEventRsvps     TeamEventAttendee[]
  notifications      Notification[]
  emailQueue         EmailQueueItem[]
  pushSubscriptions  PushSubscription[]

  @@map("users")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Magic-link tokens (identifier = token, value = JSON with the email)
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Login attempt counters (Better Auth rateLimit, storage: "database"), shared across serverless instances
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

// ───────────────────────── Content ─────────────────────────

model Programme {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  titleFr   String   @map("title_fr")
  titleAr   String?  @map("title_ar")
  titleEn   String?  @map("title_en")
  summaryFr String?  @map("summary_fr")
  summaryAr String?  @map("summary_ar")
  summaryEn String?  @map("summary_en")
  bodyFr    String?  @map("body_fr")
  bodyAr    String?  @map("body_ar")
  bodyEn    String?  @map("body_en")
  coverUrl  String?  @map("cover_url")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions Action[]
  events  Event[]

  @@map("programmes")
}

model Action {
  id                 String    @id @default(uuid()) @db.Uuid
  slug               String    @unique
  programmeId        String?   @map("programme_id") @db.Uuid
  titleFr            String    @map("title_fr")
  titleAr            String?   @map("title_ar")
  titleEn            String?   @map("title_en")
  dateStart          DateTime  @map("date_start") @db.Date
  dateEnd            DateTime? @map("date_end") @db.Date
  location           String?
  lat                Float?
  lng                Float?
  beneficiariesCount Int?      @map("beneficiaries_count")
  bodyFr             String?   @map("body_fr")
  bodyAr             String?   @map("body_ar")
  bodyEn             String?   @map("body_en")
  coverUrl           String?   @map("cover_url")
  // Report key figures: [{ value: number, labelFr, labelAr?, labelEn? }] shown as "En chiffres".
  figures            Json?
  isPublished        Boolean   @default(false) @map("is_published")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme Programme?      @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  partners  ActionPartner[]
  campaigns Campaign[]

  @@index([programmeId])
  @@index([dateStart])
  @@map("actions")
}

// Replaces spec's actions.partner_ids[] so every link points at a real partner.
model ActionPartner {
  actionId  String @map("action_id") @db.Uuid
  partnerId String @map("partner_id") @db.Uuid

  action  Action  @relation(fields: [actionId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([actionId, partnerId])
  @@index([partnerId])
  @@map("action_partners")
}

model Event {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  type             EventType
  programmeId      String?   @map("programme_id") @db.Uuid
  titleFr          String    @map("title_fr")
  titleAr          String?   @map("title_ar")
  titleEn          String?   @map("title_en")
  bodyFr           String?   @map("body_fr")
  bodyAr           String?   @map("body_ar")
  bodyEn           String?   @map("body_en")
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(3)
  location         String?
  capacity         Int?
  registrationOpen Boolean   @default(false) @map("registration_open")
  coverUrl         String?   @map("cover_url")
  isPublished      Boolean   @default(false) @map("is_published")
  createdById      String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme     Programme?     @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([type, startsAt])
  @@index([programmeId])
  @@map("events")
}

model Registration {
  id        String             @id @default(uuid()) @db.Uuid
  eventId   String             @map("event_id") @db.Uuid
  fullName  String             @map("full_name")
  phone     String
  email     String?
  city      String?
  profile   Profile
  note      String?
  status    RegistrationStatus @default(new)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Events with registrations cannot be deleted (default Restrict); unpublish them instead.
  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, phone])
  @@index([eventId, status])
  @@map("registrations")
}

// ───────────────────────── Fundraising ─────────────────────────

model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  titleFr     String    @map("title_fr")
  titleAr     String?   @map("title_ar")
  titleEn     String?   @map("title_en")
  summaryFr   String?   @map("summary_fr")
  summaryAr   String?   @map("summary_ar")
  summaryEn   String?   @map("summary_en")
  goalDh      Int       @map("goal_dh")
  // Cached from confirmed donations; recalculated inside the confirm/reject transaction.
  raisedDh    Int       @default(0) @map("raised_dh")
  donorsCount Int       @default(0) @map("donors_count")
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  coverUrl    String?   @map("cover_url")
  isActive    Boolean   @default(true) @map("is_active")
  actionId    String?   @map("action_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  action    Action?    @relation(fields: [actionId], references: [id], onDelete: SetNull)
  donations Donation[]

  @@index([actionId])
  @@map("campaigns")
}

model Donation {
  id            String         @id @default(uuid()) @db.Uuid
  campaignId    String         @map("campaign_id") @db.Uuid
  donorName     String?        @map("donor_name")
  email         String?
  phone         String?
  amountDh      Int            @map("amount_dh")
  isAnonymous   Boolean        @default(false) @map("is_anonymous")
  // Object key in the private R2 bucket; served only through short-lived signed URLs.
  proofKey      String?        @map("proof_key")
  status        DonationStatus @default(pending)
  source        DonationSource @default(form)
  adminNote     String?        @map("admin_note")
  // Set when the gift comes from a company/organisation: it then appears on the sponsor wall,
  // with its tier computed from the partner's confirmed total (sponsor_tiers.min_dh).
  partnerId     String?        @map("partner_id") @db.Uuid
  confirmedById String?        @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?      @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  partner     Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  confirmedBy User?    @relation("DonationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([partnerId])
  @@index([status, createdAt])
  @@map("donations")
}

model SponsorTier {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  minDh      Int      @map("min_dh")
  // Arrays of benefit strings, e.g. ["Logo sur les réseaux sociaux", ...]
  benefitsFr Json     @map("benefits_fr")
  benefitsAr Json?    @map("benefits_ar")
  benefitsEn Json?    @map("benefits_en")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  inquiries Inquiry[]

  @@map("sponsor_tiers")
}

// ───────────────────────── People & organisations ─────────────────────────

model Partner {
  id        String      @id @default(uuid()) @db.Uuid
  slug      String      @unique
  name      String
  logoUrl   String?     @map("logo_url")
  type      PartnerType
  website   String?
  isVisible Boolean     @default(true) @map("is_visible")
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  actions   ActionPartner[]
  donations Donation[]

  @@map("partners")
}

model TeamMember {
  id              String   @id @default(uuid()) @db.Uuid
  fullName        String   @map("full_name")
  roleFr          String   @map("role_fr")
  roleAr          String?  @map("role_ar")
  roleEn          String?  @map("role_en")
  photoUrl        String?  @map("photo_url")
  phone           String?
  isPublicContact Boolean  @default(false) @map("is_public_contact")
  order           Int      @default(0)
  isBoard         Boolean  @default(true) @map("is_board")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("team_members")
}

// ───────────────────────── Public forms ─────────────────────────

model VolunteerApplication {
  id           String          @id @default(uuid()) @db.Uuid
  fullName     String          @map("full_name")
  email        String?
  phone        String
  city         String?
  profile      Profile?
  skills       String?
  availability String?
  motivation   String?
  status       VolunteerStatus @default(new)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("volunteer_applications")
}

model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  kind         InquiryKind
  fullName     String?       @map("full_name")
  organisation String?
  email        String
  phone        String?
  message      String?
  tierId       String?       @map("tier_id") @db.Uuid
  status       InquiryStatus @default(new)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tier SponsorTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([kind, status, createdAt])
  @@map("inquiries")
}

// ───────────────────────── Media, stats, audit ─────────────────────────

// Polymorphic gallery item: owner_type + owner_id point at a programme/action/event/... (no FK by design).
model Media {
  id        String         @id @default(uuid()) @db.Uuid
  ownerType MediaOwnerType @map("owner_type")
  ownerId   String         @map("owner_id") @db.Uuid
  r2Key     String         @map("r2_key")
  url       String
  altFr     String?        @map("alt_fr")
  altAr     String?        @map("alt_ar")
  altEn     String?        @map("alt_en")
  width     Int?
  height    Int?
  order     Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerType, ownerId, order])
  @@map("media")
}

// Cached homepage counters, recalculated when the underlying data changes.
model ImpactStat {
  key       String   @id
  value     Int
  labelFr   String   @map("label_fr")
  labelAr   String?  @map("label_ar")
  labelEn   String?  @map("label_en")
  order     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("impact_stats")
}

// Small editable site values (e.g. dossier_url), managed from /admin.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

// ═════════════════════════ Members area (ex-Terminal, Phase 4) ═════════════════════════
// Imported from Supabase with the same UUIDs (users matched by email).

enum ContextType {
  project
  cellule
}

enum TeamContext {
  global
  project
  cellule
}

enum ProjectStatus {
  actif
  en_pause
  bloque
  termine
}

enum ApprovalStatus {
  en_attente
  approuve
  rejete
}

enum TaskStatus {
  a_faire
  en_cours
  bloque
  termine
}

enum TaskPriority {
  urgent
  eleve
  moyen
  faible
}

enum TeamEventType {
  activite
  action
  reunion
  evenement
}

enum TeamEventVisibility {
  tous
  invites
}

enum Rsvp {
  oui
  non
  en_attente
}

model Cellule {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  positions CellulePosition[]
  members   CelluleMember[]

  @@map("cellules")
}

model CellulePosition {
  id        String @id @default(uuid()) @db.Uuid
  celluleId String @map("cellule_id") @db.Uuid
  name      String

  cellule Cellule         @relation(fields: [celluleId], references: [id], onDelete: Cascade)
  members CelluleMember[]

  @@index([celluleId])
  @@map("cellule_positions")
}

model CelluleMember {
  id         String @id @default(uuid()) @db.Uuid
  celluleId  String @map("cellule_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  positionId String @map("position_id") @db.Uuid

  cellule  Cellule         @relation(fields: [celluleId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position CellulePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([celluleId, userId])
  @@index([userId])
  @@map("cellule_members")
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  status          ProjectStatus  @default(actif)
  approvalStatus  ApprovalStatus @default(approuve) @map("approval_status")
  isMultiActivite Boolean        @default(false) @map("is_multi_activite")
  parentProjectId String?        @map("parent_project_id") @db.Uuid
  proposedById    String?        @map("proposed_by") @db.Uuid
  startDate       DateTime?      @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  imageUrl        String?        @map("image_url")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent     Project?          @relation("SubProjects", fields: [parentProjectId], references: [id], onDelete: SetNull)
  children   Project[]         @relation("SubProjects")
  proposedBy User?             @relation("ProjectProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  positions  ProjectPosition[]
  members    ProjectMember[]
  proposals  ProjectProposal[]

  @@index([parentProjectId])
  @@map("projects")
}

model ProjectPosition {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name      String

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members ProjectMember[]

  @@index([projectId])
  @@map("project_positions")
}

model ProjectMember {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @map("project_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid
  positionId String @map("position_id") @db.Uuid

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  position ProjectPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectProposal {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  type            String         @default("Projet")
  isActivity      Boolean        @default(false) @map("is_activity")
  parentProjectId String?        @map("parent_project_id") @db.Uuid
  proposedById    String         @map("proposed_by") @db.Uuid
  suggestedChefId String?        @map("suggested_chef") @db.Uuid
  status          ApprovalStatus @default(en_attente)
  reviewNotes     String?        @map("review_notes")
  reviewedById    String?        @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  parentProject Project? @relation(fields: [parentProjectId], references: [id], onDelete: SetNull)
  proposedBy    User     @relation("ProposalBy", fields: [proposedById], references: [id], onDelete: Cascade)
  suggestedChef User?    @relation("ProposalChef", fields: [suggestedChefId], references: [id], onDelete: SetNull)
  reviewedBy    User?    @relation("ProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("project_proposals")
}

// A task belongs to one main context (project or cellule) and may appear in secondary ones.
model Task {
  id              String       @id @default(uuid()) @db.Uuid
  contextType     ContextType  @map("context_type")
  contextId       String       @map("context_id") @db.Uuid
  title           String
  description     String?
  status          TaskStatus   @default(a_faire)
  priority        TaskPriority @default(moyen)
  dueDate         DateTime?    @map("due_date") @db.Timestamptz(3)
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  archived        Boolean      @default(false)
  createdById     String       @map("created_by") @db.Uuid
  lastUpdatedById String?      @map("last_updated_by") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  lastUpdatedBy User?          @relation("TaskUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]
  contexts      TaskContext[]
  comments      TaskComment[]

  @@index([contextType, contextId])
  @@index([status, archived])
  @@map("tasks")
}

model TaskAssignee {
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskContext {
  id          String      @id @default(uuid()) @db.Uuid
  taskId      String      @map("task_id") @db.Uuid
  contextType ContextType @map("context_type")
  contextId   String      @map("context_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, contextType, contextId])
  @@index([contextType, contextId])
  @@map("task_contexts")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// Internal team events (meetings…), distinct from the public "events" table.
model TeamEvent {
  id          String              @id @default(uuid()) @db.Uuid
  title       String
  description String?
  type        TeamEventType       @default(reunion)
  contextType TeamContext         @default(global) @map("context_type")
  contextId   String?             @map("context_id") @db.Uuid
  startAt     DateTime            @map("start_at") @db.Timestamptz(3)
  endAt       DateTime?           @map("end_at") @db.Timestamptz(3)
  location    String?
  visibility  TeamEventVisibility @default(tous)
  createdById String              @map("created_by") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendees TeamEventAttendee[]
  invites   TeamEventInvite[]

  @@index([startAt])
  @@map("team_events")
}

model TeamEventAttendee {
  eventId String @map("event_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid
  rsvp    Rsvp   @default(en_attente)

  event TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("team_event_attendees")
}

// "Invite a whole project or cellule": its members are invited.
model TeamEventInvite {
  id          String      @id @default(uuid()) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  contextType ContextType @map("context_type")
  contextId   String      @map("context_id") @db.Uuid

  event TeamEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, contextType, contextId])
  @@map("team_event_invites")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  type        String
  targetId    String?   @map("target_id") @db.Uuid
  message     String
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@map("notifications")
}

// Grouped e-mail notifications, sent by the digest cron after send_after.
model EmailQueueItem {
  id          String   @id @default(uuid()) @db.Uuid
  recipientId String   @map("recipient_id") @db.Uuid
  actionType  String   @map("action_type")
  payload     Json
  sendAfter   DateTime @map("send_after") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([sendAfter])
  @@map("email_queue")
}

// Phone / browser notifications (Web Push): one row per device that said yes (/espace/parametres).
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}
