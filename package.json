{
  "name": "solident",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:terminal": "pnpm --filter ./apps/terminal dev",
    "build:terminal": "pnpm --filter ./apps/terminal build",
    "dev:web": "pnpm --filter ./apps/web dev",
    "build:web": "pnpm --filter ./apps/web build",
    "db:generate": "pnpm --filter @solident/db generate",
    "db:migrate": "pnpm --filter @solident/db migrate:dev",
    "db:status": "pnpm --filter @solident/db migrate:status",
    "db:seed": "pnpm --filter @solident/db seed",
    "db:studio": "pnpm --filter @solident/db studio"
  }
}
